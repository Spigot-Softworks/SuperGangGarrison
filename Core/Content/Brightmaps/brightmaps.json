{
  // Character brightmaps (experimental). Brighter = keeps more of its own colour in the dark.
  // "frames" lists one image per frame of the sprite (null = none). With
  // "reuseForMatchingFrames", frames without their own image borrow one from a frame with
  // the same silhouette (as it is, or moved a few pixels).
  // Images may be a whole fraction of the frame size (these are half size, like the art).
  "brightmaps": [
    {
      "sprites": [ "ElkondoHeavyRedTorsoS", "ElkondoHeavyBlueTorsoS" ],
      "frames": [ "heavy/heavy-legs-body.png" ],
      "reuseForMatchingFrames": true
    },
    {
      "sprites": [ "ElkondoHeavyRedLegsS", "ElkondoHeavyBlueLegsS" ],
      "frames": [ "heavy/heavy-legs-idle.png" ],
      "reuseForMatchingFrames": true
    },
    {
      // Legs and torso in one sprite; the idle frame is the two brightmaps layered.
      "sprites": [ "ElkondoHeavyRedBodyS", "ElkondoHeavyBlueBodyS" ],
      "frames": [ "heavy/heavy-body-idle.png" ],
      "reuseForMatchingFrames": true
    },
    {
      "sprites": [ "ElkondoHeavyRedWeaponS", "ElkondoHeavyBlueWeaponS" ],
