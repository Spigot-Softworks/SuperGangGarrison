# Merge into the environment of the existing single-worker API service.
OPENGARRISON_RELAY_PUBLIC_BASE_URL=https://api.superganggarrison.com
OPENGARRISON_API_CORS_ORIGINS=https://superganggarrison.com,https://www.superganggarrison.com
OPENGARRISON_PEER_ROOM_LIMIT=4096
# Optional JSON. Existing authenticated WebSocket relay works without TURN.
OPENGARRISON_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
