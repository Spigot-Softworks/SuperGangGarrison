<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <AssemblyName>OG2.Browser</AssemblyName>
    <RootNamespace>OpenGarrison.Client.Browser</RootNamespace>
    <OpenGarrisonClientAsLibrary>true</OpenGarrisonClientAsLibrary>
    <OpenGarrisonBrowserAot Condition="'$(OpenGarrisonBrowserAot)' == ''">true</OpenGarrisonBrowserAot>
    <OpenGarrisonBrowserBuildVersion Condition="'$(OpenGarrisonBrowserBuildVersion)' == ''">dev</OpenGarrisonBrowserBuildVersion>
    <OpenGarrisonBrowserEdition Condition="'$(OpenGarrisonBrowserEdition)' == ''">Full</OpenGarrisonBrowserEdition>
    <OpenGarrisonRoomContentId Condition="'$(OpenGarrisonRoomContentId)' == ''">dev</OpenGarrisonRoomContentId>
    <OpenGarrisonRoomServiceOrigin Condition="'$(OpenGarrisonRoomServiceOrigin)' == ''">https://api.superganggarrison.com</OpenGarrisonRoomServiceOrigin>
    <OpenGarrisonBrowserReleaseChannel Condition="'$(OpenGarrisonBrowserReleaseChannel)' == ''">stable</OpenGarrisonBrowserReleaseChannel>
    <DisableBuildCompression>true</DisableBuildCompression>
    <OpenGarrisonBrowserAssetCacheRoot Condition="'$(OpenGarrisonBrowserAssetCacheRoot)' == '' and '$(OpenGarrisonBuildRoot)' != ''">$(OpenGarrisonBuildRoot)/browser-assets</OpenGarrisonBrowserAssetCacheRoot>
    <OpenGarrisonBrowserAssetCacheRoot Condition="'$(OpenGarrisonBrowserAssetCacheRoot)' == ''">$(MSBuildProjectDirectory)/obj/browser-assets</OpenGarrisonBrowserAssetCacheRoot>
    <OpenGarrisonBrowserGeneratedWwwRoot Condition="'$(OpenGarrisonBrowserGeneratedWwwRoot)' == '' and '$(OpenGarrisonBuildRoot)' != ''">$(OpenGarrisonBuildRoot)/browser-wwwroot</OpenGarrisonBrowserGeneratedWwwRoot>
    <OpenGarrisonBrowserGeneratedWwwRoot Condition="'$(OpenGarrisonBrowserGeneratedWwwRoot)' == ''">$(MSBuildProjectDirectory)/wwwroot</OpenGarrisonBrowserGeneratedWwwRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OpenGarrisonBrowserAot)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <DisableParallelAot Condition="'$(DisableParallelAot)' == ''">true</DisableParallelAot>
    <DisableParallelEmccCompile Condition="'$(DisableParallelEmccCompile)' == ''">true</DisableParallelEmccCompile>
    <WasmNativeDebugSymbols Condition="'$(WasmNativeDebugSymbols)' == ''">false</WasmNativeDebugSymbols>
    <WasmBitcodeCompileOptimizationFlag Condition="'$(WasmBitcodeCompileOptimizationFlag)' == ''">-O1</WasmBitcodeCompileOptimizationFlag>
    <EmccVerbose Condition="'$(EmccVerbose)' == ''">false</EmccVerbose>
  </PropertyGroup>

  <Target Name="RejectNonAotBrowserPublish"
          BeforeTargets="Publish"
          Condition="'$(OpenGarrisonBrowserAot)' != 'true' or '$(RunAOTCompilation)' != 'true' or '$(OpenGarrisonSkipBrowserAssetSync)' == 'true'">
    <Error Text="The browser publish path is AOT-only. Remove non-AOT overrides and publish with OpenGarrisonBrowserAot=true." />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="OpenGarrisonBrowserEdition" Value="$(OpenGarrisonBrowserEdition)" />
    <AssemblyMetadata Include="OpenGarrisonRoomContentId" Value="$(OpenGarrisonRoomContentId)" />
    <AssemblyMetadata Include="OpenGarrisonRoomServiceOrigin" Value="$(OpenGarrisonRoomServiceOrigin)" />
    <AssemblyMetadata Include="OpenGarrisonBrowserBuildVersion" Value="$(OpenGarrisonBrowserBuildVersion)" />
    <AssemblyMetadata Include="OpenGarrisonBrowserReleaseChannel" Value="$(OpenGarrisonBrowserReleaseChannel)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.2.9001.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xna.Framework.Input">
      <HintPath>$(NuGetPackageRoot)nkast.xna.framework.input\4.2.9001\lib\net8.0\Xna.Framework.Input.dll</HintPath>
      <Aliases>KNIInput</Aliases>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\OpenGarrison.Client.csproj">
      <AdditionalProperties>OpenGarrisonClientAsLibrary=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\Plugins\Client\OpenGarrison.Client.Plugins.Abstractions\OpenGarrison.Client.Plugins.Abstractions.csproj">
      <AdditionalProperties>OpenGarrisonClientAsLibrary=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\Client.Shared\OpenGarrison.Client.Shared.csproj" />
    <ProjectReference Include="..\Core\OpenGarrison.Core.csproj" />
    <ProjectReference Include="..\Plugins\GameplayModding.Abstractions\OpenGarrison.GameplayModding.Abstractions.csproj" />
    <ProjectReference Include="..\Protocol\OpenGarrison.Protocol.csproj" />
  </ItemGroup>

  <Target Name="SyncCoreContentToBrowserWwwroot"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(OpenGarrisonSkipBrowserAssetSync)' != 'true'">
    <ItemGroup>
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot\Content\'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot/Content/'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('\wwwroot\Content\'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('/wwwroot/Content/'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot\Plugins\'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').StartsWith('wwwroot/Plugins/'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('\wwwroot\Plugins\'))" />
      <BrowserGeneratedContentItems Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('/wwwroot/Plugins/'))" />
      <BrowserStaticWebAssetCacheFiles Include="$(IntermediateOutputPath)*.dswa.cache.json;
                                           $(IntermediateOutputPath)swae.*.cache;
                                           $(IntermediateOutputPath)staticwebassets.build.json.cache" />
    </ItemGroup>

    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../Tools/Browser/browser_build_cache.py&quot; sync-assets --repo &quot;$(MSBuildProjectDirectory)/..&quot; --wwwroot &quot;$(OpenGarrisonBrowserGeneratedWwwRoot)&quot; --cache &quot;$(OpenGarrisonBrowserAssetCacheRoot)&quot; --sdk &quot;$(NETCoreSdkVersion)&quot;" />
    <!-- Refresh discovery/fingerprint metadata after synchronization, while
         retaining the expensive content-keyed gzip/Brotli outputs. -->
    <Delete Files="@(BrowserStaticWebAssetCacheFiles)" />
    <ItemGroup>
      <Content Remove="@(BrowserGeneratedContentItems)" />
      <BrowserGeneratedCoreContent Include="$(OpenGarrisonBrowserGeneratedWwwRoot)/Content/**/*"
                                   Exclude="$(OpenGarrisonBrowserGeneratedWwwRoot)/Content/**/*.cs" />
      <BrowserGeneratedPluginContent Include="$(OpenGarrisonBrowserGeneratedWwwRoot)/Plugins/**/*" />
      <!-- Qualify metadata to the generated items: unqualified metadata here
           batches over existing Content and can give every asset app.css's path. -->
      <Content Include="@(BrowserGeneratedCoreContent)"
               Link="wwwroot/Content/%(BrowserGeneratedCoreContent.RecursiveDir)%(BrowserGeneratedCoreContent.Filename)%(BrowserGeneratedCoreContent.Extension)"
               ContentRoot="$(OpenGarrisonBrowserGeneratedWwwRoot)/"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(BrowserGeneratedPluginContent)"
               Link="wwwroot/Plugins/%(BrowserGeneratedPluginContent.RecursiveDir)%(BrowserGeneratedPluginContent.Filename)%(BrowserGeneratedPluginContent.Extension)"
               ContentRoot="$(OpenGarrisonBrowserGeneratedWwwRoot)/"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="EnsureBrowserStaticWebAssetsBuildManifestForPublish"
          BeforeTargets="_CleanupReferencedProjectItemGroups"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration;GenerateStaticWebAssetsManifest"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'" />

  <Target Name="CleanBrowserMirroredContent" AfterTargets="Clean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\Content" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\Plugins" />
  </Target>

  <Target Name="PruneObsoleteBrowserPublishFiles" AfterTargets="Publish">
    <WriteLinesToFile File="$(IntermediateOutputPath)browser-publish-files.txt"
                      Lines="@(_PublishStaticWebAssetsTargetPath->'%(TargetPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../Tools/Browser/browser_build_cache.py&quot; prune-publish --wwwroot &quot;$(PublishDir)wwwroot&quot; --inventory &quot;$(IntermediateOutputPath)browser-publish-files.txt&quot;" />
  </Target>
</Project>
