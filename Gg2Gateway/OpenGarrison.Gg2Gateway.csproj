<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenGarrison.Gg2Gateway</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Client/OpenGarrison.Client.csproj">
      <AdditionalProperties>OpenGarrisonClientAsLibrary=true;OpenGarrisonPackageScriptOwnsContent=true</AdditionalProperties>
    </ProjectReference>
    <Content Include="../Core/Content/Gameplay/**/*.json"
             Link="Content/Gameplay/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Core/Content/StockMaps/Gg2/*.png"
             Link="Content/StockMaps/Gg2/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
