root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

[*.{ps1,props,targets,csproj,sln}]
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 reads BOM-less scripts as ANSI; keep the BOM there.
[*.ps1]
charset = utf-8-bom

[*.sh]
indent_style = space
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

# Dead-code checks for the simulation. Reported in the build because
# OpenGarrison.Core sets EnforceCodeStyleInBuild (Directory.Build.props).
[Core/Simulation/**.cs]
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
